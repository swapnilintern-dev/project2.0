<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE network policy: HTTPS only, everywhere. Plain-HTTP (cleartext)
  traffic is denied for every host — the store build only ever talks to the
  HTTPS backend in lib/services/api_config.dart.

  The dev hosts (emulator 10.0.2.2, localhost, the LAN IP of the dev PC) are
  allowed ONLY in debug builds, by the same-named file in
  android/app/src/debug/res/xml/, which overrides this one for `flutter run`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
